{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "bun",
  "outputDirectory": ".",
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run check && bun run test:postgres && bun run build",
  "regions": ["iad1"],
  "functions": {
    "src/server.ts": {
      "includeFiles": "{fixtures,dist,node_modules}/**",
      "excludeFiles": "node_modules/{typescript,@typescript,prettier,playwright,playwright-core,@playwright,@types,bun-types}/**",
      "maxDuration": 120
    }
  }
}
