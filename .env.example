# Default is live. Set demo explicitly for the deterministic, offline Pi provider.
AGENT_MODE=live
MODEL_PROVIDER=openai
MODEL_ID=gpt-6-luna
MODEL_API_KEY=
# Required for openai-compatible; optional endpoint override for native providers.
MODEL_BASE_URL=

HOST=127.0.0.1
PORT=3000
SESSION_DB_PATH=.data/sessions.sqlite
# Optional locally; required on Vercel. Use a dedicated PostgreSQL database.
DATABASE_URL=

# Proposed business defaults. Identity always requires 3 distinct actual matches.
MAX_IDENTITY_FAILURES=3
MAX_CONSECUTIVE_OFF_TOPIC=3
AUTHORIZATION_TIMEOUT_MS=30000
SESSION_IDLE_TIMEOUT_MS=1800000

# Authorization is simulated; the supplied representative has no identity record.
AUTHORIZATION_SCENARIO=default
# mock never sends mail. webhook requires a configured email gateway.
EMAIL_MODE=mock
EMAIL_MOCK_FAILURES=0
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
