{
  "name": "claimflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.18",
  "engines": {
    "bun": ">=1.2.18"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:demo": "AGENT_MODE=demo bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun scripts/build-ui.ts",
    "smoke": "bun scripts/pi-smoke.ts",
    "test": "bun test",
    "test:postgres": "bun scripts/test-postgres.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run typecheck && bun test",
    "test:browser": "bun --bun node_modules/@playwright/test/cli.js test",
    "browser:install": "bun --bun node_modules/@playwright/test/cli.js install chromium",
    "eval": "bun evals/run.ts",
    "eval:live": "bun evals/run.ts --live",
    "smoke:http": "bun scripts/http-smoke.ts",
    "format": "bun --bun node_modules/prettier/bin/prettier.cjs --write src scripts tests evals playwright.config.ts",
    "format:check": "bun --bun node_modules/prettier/bin/prettier.cjs --check src scripts tests evals playwright.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@radix-ui/themes": "3.3.0",
    "@tanstack/react-query": "5.104.3",
    "eventsource-parser": "4.1.2",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
